{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    // Inject Jest globals (describe, it, expect, jest.*) vào TypeScript
    "types": ["jest", "node"],
    // Tests dùng CommonJS (ts-jest chạy CJS)
    "module": "CommonJS",
    "moduleResolution": "node"
  },
  // Bao gồm src/ + toàn bộ tests/ (kể cả subdirectory unit/, integration/, setup/...)
  "include": ["src/**/*", "tests/**/*", "prisma/**/*"],
  // Không exclude test files — config này dành riêng cho test
  "exclude": ["node_modules", "dist"]
}

