# App Config
NODE_ENV=development
PORT=5000
API_VERSION=v1

# Database Configuration (MySQL)
# Replace placeholders with your local database credentials.
# Never commit real database credentials.
DATABASE_URL=mysql://your_db_user:your_db_password@localhost:3306/maverik_store

# JWT Setup
JWT_SECRET=replace-with-a-random-jwt-secret-at-least-32-chars
JWT_EXPIRE=7d

# Bcrypt Config
BCRYPT_ROUNDS=10

# Email OTP Registration
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM="Maverik Store <noreply@yourdomain.com>"
OTP_SECRET=replace-with-a-random-otp-secret-at-least-32-chars

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Logging Options
LOG_LEVEL=debug

# Supabase Storage
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=product-images

# Gemini AI Chatbot
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# VNPay
VNPAY_TMN_CODE=your-vnpay-tmn-code
VNPAY_HASH_SECRET=replace-with-your-vnpay-hash-secret-at-least-16-chars
VNPAY_RETURN_URL=http://localhost:5000/api/v1/payments/vnpay/return
VNPAY_FRONTEND_RETURN=http://localhost:5173/vnpay-return.html
VNPAY_IPN_URL=http://localhost:5000/api/v1/payments/vnpay/ipn
