{
  "name": "maverik-store-api",
  "version": "1.0.0",
  "description": "Maverik Store E-commerce Backend API",
  "main": "dist/src/server.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon --exec tsx src/server.ts",
    "build": "tsc",
    "start": "node dist/src/server.js",
    "test": "jest --config jest.config.cjs --runInBand",
    "test:unit": "jest --config jest.config.cjs --runInBand --testPathIgnorePatterns=/tests/integration/",
    "test:integration": "jest --config jest.config.cjs --runInBand tests/integration",
    "test:watch": "npx jest --config jest.config.cjs --watch",
    "test:coverage": "jest --config jest.config.cjs --coverage --runInBand",
    "lint": "eslint src tests --max-warnings=0",
    "lint:fix": "eslint src tests --fix",
    "smoke:production": "node scripts/smoke-production.mjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:seed": "tsx prisma/seed.ts",
    "migrate:images": "tsx scripts/migrate-product-images-to-supabase.ts"
  },
  "keywords": [
    "ecommerce",
    "maverik",
    "store",
    "api"
  ],
  "author": "Maverik Store Dev Team",
  "license": "ISC",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "^5.7.1",
    "@supabase/supabase-js": "^2.105.4",
    "axios": "^1.16.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "querystring": "^0.2.1",
    "slugify": "^1.6.9",
    "vnpay": "^2.5.0",
    "ws": "^8.20.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.10.6",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^10.8.0",
    "globals": "^17.7.0",
    "jest": "^30.3.0",
    "nodemon": "^3.0.2",
    "prisma": "^5.7.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
